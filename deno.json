{
  "tasks": {
    "dev": "deno run --watch=views,public,src --unstable-kv --allow-write=.data --allow-net --allow-read --allow-env src/main.ts",
    "start": "deno run --unstable-kv --allow-write=.data --allow-net --allow-read --allow-env src/main.ts",
    "test": "deno test --unstable-kv --allow-net --allow-read --allow-env",
    "reports": "deno run --unstable-kv --allow-read=.data --allow-write=.data scripts/list-reports.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "hono/cookie": "jsr:@hono/hono@^4/cookie",
    "hono/compress": "jsr:@hono/hono@^4/compress",
    "hono/deno": "jsr:@hono/hono@^4/deno",
    "hono/": "jsr:@hono/hono@^4/",
    "ventojs": "https://deno.land/x/vento@v1.12.12/mod.ts",
    "psl": "npm:psl@^1.9.0",
    "parse-domain": "npm:parse-domain@^5.0.0"
  },
  "compilerOptions": {
    "strict": true
  }
}
